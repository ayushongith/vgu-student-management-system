{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Django: Run Server",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/manage.py",
            "args": [
                "runserver"
            ],
            "django": true,
            "autoReload": {
                "enable": true
            },
            "python": "${workspaceFolder}/venv/Scripts/python.exe"
        },
        {
            "name": "Django: Run Tests",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/manage.py",
            "args": [
                "test"
            ],
            "django": true,
            "python": "${workspaceFolder}/venv/Scripts/python.exe"
        }
    ]
}
